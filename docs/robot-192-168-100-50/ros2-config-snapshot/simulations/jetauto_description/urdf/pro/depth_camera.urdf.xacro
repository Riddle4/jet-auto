<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="M_PI"                   value="3.1415926535897931"/>
  <xacro:property name="depth_camera_name"      default="camera" />
  <xacro:property name="depth_camera_link_mass" value="0.200" />
  <xacro:property name="depth_camera_link_w"    value="0.1644" />
  <xacro:property name="depth_camera_link_h"    value="0.05" />
  <xacro:property name="depth_camera_link_d"    value="0.051" />
  <link
    name="depth_cam_link">
    <inertial>
      <origin
        xyz="-0.0216754261268798 0.000433030261824542 -0.00522162357356321"
        rpy="0 0 0" />
      <mass
        value="0.225531197124311" />
      <inertia
        ixx="0.000408533739671016"
        ixy="-7.53224339510841E-09"
        ixz="1.70006612530887E-07"
        iyy="4.81514412396621E-05"
        iyz="-5.07454108383215E-09"
        izz="0.000428969211089537" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://jetauto_description/meshes/pro/depth_camera_link.stl" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://jetauto_description/meshes/depth_camera_link_collision.stl" />
      </geometry>
    </collision>
  </link>
  <joint
    name="depth_cam_joint"
    type="fixed">
    <origin
      xyz="0.0465053533011977 -0.000283778735413798 0.152330838253393"
      rpy="0 0 0" />
    <parent
      link="connect_link" />
    <child
      link="depth_cam_link" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link name="depth_cam_frame" />
  <joint
    name="depth_cam_joint_sim"
    type="fixed">
    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}" />
    <parent link="depth_cam_link" />
    <child link="depth_cam_frame" />
  </joint>
</robot>
